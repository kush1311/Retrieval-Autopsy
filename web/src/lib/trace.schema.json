        "Span": {
          "additionalProperties": false,
          "description": "A sentence-level slice of the answer mapped back to its supporting chunks.\n\nPanel C's attribution hover reads this, and so does the grounding check in the\neval \u2014 one field serving the demo and the test suite is the whole point.",
          "properties": {
            "start": {
              "title": "Start",
              "type": "integer"
            },
            "end": {
              "title": "End",
              "type": "integer"
            },
            "chunk_ids": {
