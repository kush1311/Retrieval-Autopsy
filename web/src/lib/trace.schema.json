        "CacheState": {
          "enum": [
            "hit",
            "miss"
          ],
          "title": "CacheState",
          "type": "string"
        },
        "Candidate": {
          "additionalProperties": false,
          "description": "One retrieval candidate, with its standing in every leg it appeared in.\n\nPer-leg rank *and* raw score are both recorded. Rank is what panel A positions by;\nthe raw score is rendered as text beside it. They are not interchangeable \u2014 see\nthe note on score scales in the rendering constraints.",
          "properties": {
            "chunk_id": {
              "title": "Chunk Id",
              "type": "string"
            },
            "doc_id": {
              "title": "Doc Id",
              "type": "string"
            },
            "heading_path": {
              "items": {
                "type": "string"
              },
              "title": "Heading Path",
              "type": "array"
            },
            "text": {
              "title": "Text",
              "type": "string"
            },
            "ordinal": {
              "title": "Ordinal",
              "type": "integer"
            },
            "tenant_id": {
              "title": "Tenant Id",
              "type": "string"
            },
            "lexical_rank": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Lexical Rank"
