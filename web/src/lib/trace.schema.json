            "lexical_score": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Lexical Score"
            },
            "semantic_rank": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Semantic Rank"
            },
            "semantic_score": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Semantic Score"
            },
            "fused_rank": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Fused Rank"
            },
            "fused_score": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
